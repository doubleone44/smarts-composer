cabal-version:      2.4
name:               smarts-composer
version:            0.1.0.0

author:             Mees Hendriks
maintainer:         mees@hendriks.org

extra-source-files: CHANGELOG.md

executable smarts-composer
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:    
      base >=4.17 && <4.19, 
      parsec ^>=3.1.16.0,
      fgl ^>=5.8.3.0,
      smarts-composer

library
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:   
    containers ^>=0.6.7, 
    containers ^>=0.6.7, 
    base >=4.17 && <4.19,
    parsec ^>=3.1.16.0,
    fgl ^>=5.8.3.0
  exposed-modules: 
    Data.AST
    Parser.Smarts
    Semantic.Graph
  other-modules:
    Parser.Logical
    Parser.Atom
    Parser.Bond
    Parser.Ring

test-suite smarts-composer-test
  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:   
    base >=4.17 && <4.19,
    fgl ^>=5.8.3.0,
    parsec ^>=3.1.16.0,
    smarts-composer,
    tasty,
    tasty-hunit
  main-is:          Main.hs
  type:            exitcode-stdio-1.0